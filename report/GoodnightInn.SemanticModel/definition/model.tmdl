model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["BookingChannels","Brands","Contents","FinanceAssumptions","FinanceParameters","GuestComplaints","GuestExperience","Hotels","GuestSegments","InvestmentProjectProperties","InvestmentProjects","InvestmentScenarios","MonthlyPerformance","Region","Renovations","Scenario"]

annotation PBI_ProTooling = ["DevMode"]

ref table BookingChannels
ref table Brands
ref table Contents
ref table FinanceAssumptions
ref table FinanceParameters
ref table GuestComplaints
ref table GuestExperience
ref table Hotels
ref table GuestSegments
ref table InvestmentProjectProperties
ref table InvestmentProjects
ref table InvestmentScenarios
ref table MonthlyPerformance
ref table Region
ref table Renovations
ref table Scenario

ref cultureInfo en-US

