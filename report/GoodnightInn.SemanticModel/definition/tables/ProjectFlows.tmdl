	column PresentValueUSD
		lineageTag: c4362032-6fb4-4253-9236-6f51cb6e8d34
		summarizeBy: sum
		isNameInferred
		sourceColumn: [PresentValueUSD]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ProjectFlows = calculated
		mode: import
		source =
				
				VAR _Brand = "Goodnight Inn"
				VAR _R1 = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Ramp-up - first year after completion" )
				VAR _R2 = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Ramp-up - second year after completion" )
				VAR _R3 = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Ramp-up - third year onwards" )
				VAR _DR = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" )
				VAR _Proj =
				    ADDCOLUMNS (
				        SELECTCOLUMNS (
				            FILTER ( InvestmentProjects, InvestmentProjects[Brand] = _Brand ),
				            "ProjectID", InvestmentProjects[ProjectID],
				            "Capex", InvestmentProjects[CapexUSD],
				            "Dur", InvestmentProjects[DurationMonths],
				            "OOS", InvestmentProjects[RoomsOutOfServicePct],
				            "Earliest", InvestmentProjects[EarliestStart],
				            "Dep", InvestmentProjects[DependsOn]
				        ),
				        "StartDate",
				            VAR _d = [Dep]
				            VAR _depEnd =
				                IF ( _d <> "",
				                    EDATE (
				                        LOOKUPVALUE ( InvestmentProjects[EarliestStart], InvestmentProjects[ProjectID], _d ),
				                        LOOKUPVALUE ( InvestmentProjects[DurationMonths], InvestmentProjects[ProjectID], _d ) ) )
				            RETURN IF ( _depEnd > [Earliest], _depEnd, [Earliest] )
				    )
				VAR _Proj2 = ADDCOLUMNS ( _Proj, "EndDate", EDATE ( [StartDate], [Dur] ) )
				VAR _Months = SELECTCOLUMNS ( FILTER ( 'Date', DAY ( 'Date'[Date] ) = 1 && 'Date'[Year] >= 2026 ), "Month", 'Date'[Date] )
				VAR _Grid = CROSSJOIN ( _Proj2, _Months, SELECTCOLUMNS ( Scenario, "Scenario", Scenario[Scenario] ) )
				VAR _Step1 =
				    ADDCOLUMNS ( _Grid,
				        "Building", [Month] >= [StartDate] && [Month] < [EndDate],
				        "MonthsAfterEnd", ( YEAR ( [Month] ) - YEAR ( [EndDate] ) ) * 12 + MONTH ( [Month] ) - MONTH ( [EndDate] ),
				        "AnnualProfit", LOOKUPVALUE ( InvestmentScenarios[AnnualOperatingProfitImpactUSD],
				            InvestmentScenarios[ProjectID], [ProjectID], InvestmentScenarios[Scenario], [Scenario] ),
				        "AnnualRevenue", LOOKUPVALUE ( InvestmentScenarios[AnnualRevenueImpactUSD],
				            InvestmentScenarios[ProjectID], [ProjectID], InvestmentScenarios[Scenario], [Scenario] )
				    )
				VAR _Step2 =
				    ADDCOLUMNS ( _Step1,
				        "Ramp", SWITCH ( TRUE (), [MonthsAfterEnd] < 0, 0, [MonthsAfterEnd] < 12, _R1, [MonthsAfterEnd] < 24, _R2, _R3 ),
				        "CapexUSD", IF ( [Building], DIVIDE ( [Capex], [Dur] ), 0 ),
				        "LostRevenueUSD",
				            IF ( [Building] && [OOS] > 0,
				                VAR _pid = [ProjectID]
				                VAR _mo = MONTH ( [Month] )
				                VAR _hotels = SELECTCOLUMNS ( FILTER ( InvestmentProjectProperties, InvestmentProjectProperties[ProjectID] = _pid ), "H", InvestmentProjectProperties[HotelID] )
				                RETURN [OOS] * SUMX ( FILTER ( MonthlyPerformance,
				                        YEAR ( MonthlyPerformance[Month] ) = 2025 && MONTH ( MonthlyPerformance[Month] ) = _mo
				                            && MonthlyPerformance[HotelID] IN _hotels ), MonthlyPerformance[TotalRevenue] ),
				                0 )
				    )
				VAR _Step3 =
				    ADDCOLUMNS ( _Step2,
				        "ProfitImpactUSD", [Ramp] * [AnnualProfit] / 12,
				        "RevenueImpactUSD", [Ramp] * [AnnualRevenue] / 12,
				        "DiscountFactor", POWER ( 1 + _DR, - DATEDIFF ( DATE ( 2026, 1, 1 ), [Month], DAY ) / 365.25 )
				    )
				RETURN
				    SELECTCOLUMNS ( _Step3,
				        "ProjectID", [ProjectID], "Month", [Month], "Scenario", [Scenario],
				        "StartDate", [StartDate], "EndDate", [EndDate],
				        "CapexUSD", [CapexUSD], "LostRevenueUSD", [LostRevenueUSD],
				        "ProfitImpactUSD", [ProfitImpactUSD], "RevenueImpactUSD", [RevenueImpactUSD],
				        "NetCashFlowUSD", [ProfitImpactUSD] - [LostRevenueUSD] - [CapexUSD],
				        "DiscountFactor", [DiscountFactor],
				        "PresentValueUSD", ( [ProfitImpactUSD] - [LostRevenueUSD] - [CapexUSD] ) * [DiscountFactor]
				    )

	annotation PBI_Id = 2bbfd47ceee54ad09f376234dc62192e

