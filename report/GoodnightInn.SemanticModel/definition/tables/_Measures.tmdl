table _Measures
	lineageTag: a18cd67f-6502-4b17-b786-b118f2312192

	measure 'Rooms Sold' = SUM ( MonthlyPerformance[RoomsSold] )
		formatString: 0
		lineageTag: 8afaf03f-a114-4816-98ec-88530bb57734

	measure 'Rooms Available' = SUM ( MonthlyPerformance[RoomsAvailable] )
		formatString: 0
		lineageTag: 549aac3b-0e1d-4036-bc26-e164bc6a7770

	measure 'Room Revenue' = SUM ( MonthlyPerformance[RoomRevenue] )
		formatString: 0
		lineageTag: 986a7527-0b9c-4e0a-9f05-8ccd06b33387

	measure 'Total Revenue' = SUM ( MonthlyPerformance[TotalRevenue] )
		formatString: 0
		lineageTag: 8c6e3dfc-c2c9-4439-b2bb-3bcfe4e52039

	measure 'Operating Expenses' = SUM ( MonthlyPerformance[TotalOperatingExpenses] )
		formatString: 0
		lineageTag: 39ccbe37-012d-4a6c-bd36-d6721d4e12a1

	measure 'Occupancy %' = DIVIDE ( [Rooms Sold], [Rooms Available] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b333c821-53fd-4858-9177-626dea300c20

	measure ADR = DIVIDE ( [Room Revenue], [Rooms Sold] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8db7947f-2eea-4c08-94d5-f875d6e194fe

	measure RevPAR = DIVIDE ( [Room Revenue], [Rooms Available] )
		lineageTag: 696a1ba9-f1be-4ba6-ba4f-dbe37be90074

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GOP = [Total Revenue] - [Operating Expenses]
		formatString: 0
		lineageTag: e2a3e20a-d373-4301-99d1-b542baca4068

	measure 'GOP Margin %' = DIVIDE ( [GOP], [Total Revenue] )
		lineageTag: d3709cbf-bb2a-4f21-8154-43015b23eefd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Distribution Cost' = SUM ( BookingChannels[DistributionCost] )
		formatString: 0
		lineageTag: fe3c9cab-be32-4220-9c6c-975f3f93b4ab

	measure 'Profit After Distribution' = [GOP] - [Distribution Cost]
		formatString: 0
		lineageTag: 85686cf0-07e2-4c08-a62f-0b7561f1b75b

	measure 'Margin After Distribution %' = DIVIDE ( [Profit After Distribution], [Total Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 35e12842-c95b-4824-8663-890e0d8c70b2

	measure 'Channel Room Revenue' = SUM ( BookingChannels[RoomRevenue] )
		formatString: 0
		lineageTag: 9f9b56fb-f1b4-4047-96c0-36d45e592c80

	measure 'Distribution Cost %' = DIVIDE ( [Distribution Cost], [Channel Room Revenue] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4a89e2ea-d085-4bcf-aa1e-3975e4ab6335

	measure 'OTA Share %' =
			
			DIVIDE (
			    CALCULATE ( [Channel Room Revenue], BookingChannels[Channel] = "Online Travel Agencies" ),
			    CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( BookingChannels[Channel] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 991934e2-1c57-43f2-b058-4f616b4412f3

	measure 'Direct Share %' =
			
			DIVIDE (
			    CALCULATE (
			        [Channel Room Revenue],
			        BookingChannels[Channel] IN { "Direct Website & App", "Direct Phone & Walk-in" }
			    ),
			    CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( BookingChannels[Channel] ) )
			)
		formatString: 0%;-0%;0%
		lineageTag: f386cd8a-bfcd-4537-9218-dd2515d2f4f4

	measure 'Channel Mix %' =
			
			DIVIDE (
			    [Channel Room Revenue],
			    CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( BookingChannels[Channel] ) )
			)
		lineageTag: f2a82338-7e81-4db8-844c-a15ddb26c1a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Survey Responses' = SUM ( GuestExperience[SurveyResponses] )
		formatString: 0
		lineageTag: cf1fa567-eb81-4cfb-a66c-da8281e9bd26

	measure NPS =
			
			DIVIDE (
			    SUMX ( GuestExperience, GuestExperience[NetPromoterScore] * GuestExperience[SurveyResponses] ),
			    [Survey Responses]
			)
		formatString: 0.0
		lineageTag: 44c6638b-3c15-48dd-9d4a-2f12f7a22de1

	measure 'Overall Score' =
			
			DIVIDE (
			    SUMX ( GuestExperience, GuestExperience[OverallScore] * GuestExperience[SurveyResponses] ),
			    [Survey Responses]
			)
		lineageTag: 02fc8c17-dd91-4e20-b0fc-d70509b5ab44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Room Comfort Score' =
			
			DIVIDE (
			    SUMX ( GuestExperience, GuestExperience[RoomComfortScore] * GuestExperience[SurveyResponses] ),
			    [Survey Responses]
			)
		lineageTag: 6a7a0049-c9c9-4551-8bc3-9397a9f93b48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Complaints = SUM ( GuestComplaints[Complaints] )
		formatString: 0
		lineageTag: 36f41243-1a1e-4982-9d6b-80f89e1a7726

	measure 'Complaints per 1k Room Nights' = DIVIDE ( [Complaints], [Rooms Sold] ) * 1000
		lineageTag: a23699b7-36a3-4c10-badc-755d39d7af20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ADR YoY %' =
			
			VAR _cy = [ADR]
			VAR _py = CALCULATE ( [ADR], DATEADD ( 'Date'[Date], -1, YEAR ) )
			RETURN DIVIDE ( _cy - _py, _py )
		lineageTag: d38bcf68-17ff-4b82-aab1-e4853a139b78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NPS Change vs 2021' =
			
			[NPS] - CALCULATE ( [NPS], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 )
		lineageTag: 77428bc1-0b56-4f39-a684-bfecb080d26d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Occupancy Pill' =
			
			VAR _d = ( [Occupancy %] - [Occupancy % PY] ) * 100
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs "
			        & ( MAX ( 'Date'[Year] ) - 1 )
		lineageTag: 2fb27eb3-a1c8-4132-a81e-f33d648bc1cb

	measure 'Occupancy % PY' = CALCULATE ( [Occupancy %], DATEADD ( 'Date'[Date], -1, YEAR ) )
		lineageTag: 59c4adfc-4f75-4b53-a566-48a3f323b3dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Occupancy Footer' =
			
			"2021: " & FORMAT ( CALCULATE ( [Occupancy %], 'Date'[Year] = 2021 ), "0.0%" )
		lineageTag: 9d93ff9c-b63a-4c02-b850-8438dd6ce5b9

	measure 'Occupancy Icon' =
			
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23E8EDF6'/><g fill='none' stroke='%232F5A9E' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M7 10v12M7 18h18v4M7 15h18M25 15v3'/><circle cx='11' cy='12.5' r='1.5'/><path d='M15 15v-3h7a3 3 0 0 1 3 3'/></g></svg>"
		lineageTag: f2a9a8ab-af4b-4c6d-8827-a2f17dc8d329
		dataCategory: ImageUrl

	measure 'ADR Pill' =
			
			IF ( [ADR YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [ADR YoY %] ), "0.0%" ) & " vs " & ( MAX ( 'Date'[Year] ) - 1 )
		lineageTag: 5859a10e-19d9-44ec-8ba1-e7c2166c3aa8

	measure 'OTA Pill' =
			
			VAR _d = ( [OTA Share %] - [OTA Share % PY] ) * 100
			RETURN IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs " & ( MAX ( 'Date'[Year] ) - 1 )
		lineageTag: 16a661ab-765f-41b1-95ed-392208137a58

	measure 'ADR Δ Color' = IF ( [ADR YoY %] >= 0, "#2F5A9E", "#E8231D" )
		lineageTag: d5ac2644-c6bd-456a-b496-419455d87f9f

	measure 'Margin After Distribution % PY' = CALCULATE ( [Margin After Distribution %], DATEADD ( 'Date'[Date], -1, YEAR ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 29bcbd97-698f-4279-ae11-6bf3b11e434d

	measure 'Margin Δ Color' = IF ( [Margin After Distribution %] >= [Margin After Distribution % PY], "#2F5A9E", "#E8231D" )
		lineageTag: f6bff763-ec15-4ce4-ab51-d1fcc9e9bd05

	measure 'NPS PY' = CALCULATE ( [NPS], DATEADD ( 'Date'[Date], -1, YEAR ) )
		lineageTag: 0a5ff9b6-bdd9-4ed7-8a09-f5be3450fc49

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NPS Δ Color' = IF ( [NPS] >= [NPS PY], "#2F5A9E", "#E8231D" )
		lineageTag: 402a7c19-a5ad-44bf-8777-bda063027b2a

	measure 'Occupancy Δ Color' = IF ( [Occupancy %] >= [Occupancy % PY], "#2F5A9E", "#E8231D" )
		lineageTag: a72313ec-7c00-47a8-9ea1-03441683eb63

	measure 'OTA Share % PY' = CALCULATE ( [OTA Share %], DATEADD ( 'Date'[Date], -1, YEAR ) )
		lineageTag: e6ccaeea-50cb-464c-ac9c-9c6ff096a4f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'OTA Δ Color' = IF ( [OTA Share %] > [OTA Share % PY], "#E8231D", "#2F5A9E" )
		lineageTag: 384d3d0a-b442-40aa-a82f-5fa7d776a575

	measure 'Margin Pill' =
			
			VAR _d = ( [Margin After Distribution %] - [Margin After Distribution % PY] ) * 100
			RETURN IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs " & ( MAX ( 'Date'[Year] ) - 1 )
		lineageTag: 9cea8d0d-d118-44e4-a8b2-7ba0ed3feaca

	measure 'NPS Pill' =
			
			VAR _d = [NPS] - [NPS PY]
			RETURN IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " vs " & ( MAX ( 'Date'[Year] ) - 1 )
		lineageTag: f1e1b592-03cc-41a7-9b1a-8051ec601025

	measure 'Complaints Change %' =
			
			VAR _now  = CALCULATE ( [Complaints per 1k Room Nights], 'Date'[Year] = 2025 )
			VAR _then = CALCULATE ( [Complaints per 1k Room Nights], 'Date'[Year] = 2021 )
			RETURN DIVIDE ( _now - _then, _then )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dfe9cfe0-901e-4c68-b72f-8a60767344aa

	measure 'Scenario Used' = SELECTEDVALUE ( Scenario[Scenario], "Expected" )
		lineageTag: 3996afe6-aee2-4a28-85e6-54ab2725d06c

	measure 'Brand Budget' = LOOKUPVALUE ( Brands[InvestmentBudgetUSD], Brands[Brand], "Goodnight Inn" )
		formatString: 0
		lineageTag: e0d63985-9a45-4523-83b9-91675aa1b4c4

	measure 'Portfolio Capex' =
			
			CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), InvestmentProjects[Brand] = "Goodnight Inn" )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 93f54124-84b5-43ff-8e2c-bf62d50dd276

	measure 'Budget Remaining' = [Brand Budget] - [Portfolio Capex]
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 2532ef46-1417-43e8-8095-50596c18fbe5

	measure 'Investment Capex' =
			
			VAR _s = [Scenario Used]
			RETURN CALCULATE ( SUM ( ProjectFlows[CapexUSD] ), REMOVEFILTERS ( Scenario ), ProjectFlows[Scenario] = _s )
		lineageTag: e67ea54c-aa30-47a8-9c8e-21934cc047a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Incremental Operating Profit' =
			
			VAR _s = [Scenario Used]
			RETURN CALCULATE ( SUM ( ProjectFlows[ProfitImpactUSD] ), REMOVEFILTERS ( Scenario ), ProjectFlows[Scenario] = _s )
		lineageTag: 67de62cf-4de7-46c5-a69d-2264b62ac3d2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Lost During Works' =
			
			VAR _s = [Scenario Used]
			RETURN CALCULATE ( SUM ( ProjectFlows[LostRevenueUSD] ), REMOVEFILTERS ( Scenario ), ProjectFlows[Scenario] = _s )
		lineageTag: 6e65aa95-f86e-4c70-afda-7464354b65e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Cash Flow' =
			
			VAR _s = [Scenario Used]
			RETURN CALCULATE ( SUM ( ProjectFlows[NetCashFlowUSD] ), REMOVEFILTERS ( Scenario ), ProjectFlows[Scenario] = _s )
		lineageTag: 69941b0b-6479-42e6-b333-d8d89e765886

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NPV to 2032' =
			
			VAR _s = [Scenario Used]
			RETURN
			    CALCULATE (
			        SUM ( ProjectFlows[PresentValueUSD] ),
			        REMOVEFILTERS ( Scenario ), REMOVEFILTERS ( 'Date' ),
			        ProjectFlows[Scenario] = _s
			    )
		formatString: #,0.0
		lineageTag: 0b6a11f2-d224-4556-a436-7d23c4ad426c

	measure 'Run-rate Profit 2032' =
			
			VAR _s = [Scenario Used]
			RETURN
			    CALCULATE (
			        SUM ( ProjectFlows[ProfitImpactUSD] ),
			        REMOVEFILTERS ( Scenario ), REMOVEFILTERS ( 'Date' ),
			        ProjectFlows[Scenario] = _s,
			        'Date'[Year] = 2032
			    )
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 9ba7a026-094e-4cca-bedf-02003e38c5d4

	measure 'Cumulative Net Cash Flow' =
			
			VAR _s = [Scenario Used]
			VAR _last = MAX ( 'Date'[Date] )
			RETURN
			    CALCULATE (
			        SUM ( ProjectFlows[NetCashFlowUSD] ),
			        REMOVEFILTERS ( Scenario ), REMOVEFILTERS ( 'Date' ),
			        ProjectFlows[Scenario] = _s,
			        ProjectFlows[Month] <= _last
			    )
		lineageTag: dc8fea2e-9c40-4f5b-a695-d3e52a409040

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cash Out' =
			
			- ( [Investment Capex] + [Revenue Lost During Works] )
		lineageTag: e87b6409-6ff1-4c89-9681-7e191f958b0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Not Funded Panel' = ```
			
			VAR _s  = [Scenario Used]
			VAR _X0 = 170
			VAR _SC = 12
			VAR _GI = FILTER ( ALL ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" )
			VAR _Funded    = FILTER ( _GI, InvestmentProjects[Recommended] = "Funded" )
			VAR _NotFunded = FILTER ( _GI, InvestmentProjects[Recommended] = "Not funded" )
			VAR _FundCapex  = SUMX ( _Funded, InvestmentProjects[CapexUSD] )
			VAR _FundProfit =
			    SUMX ( _Funded,
			        LOOKUPVALUE ( InvestmentScenarios[AnnualOperatingProfitImpactUSD],
			            InvestmentScenarios[ProjectID], InvestmentProjects[ProjectID],
			            InvestmentScenarios[Scenario], _s ) )
			VAR _Plan = DIVIDE ( _FundCapex, _FundProfit )
			VAR _fxNum = _X0 + MIN ( _Plan, 15 ) * _SC
			VAR _fx = FORMAT ( _fxNum, "0" )
			VAR _fxLabel = FORMAT ( _fxNum + 4, "0" )
			VAR _Rows = ADDCOLUMNS ( _NotFunded, "@rank", RANKX ( _NotFunded, InvestmentProjects[CapexUSD], , DESC, DENSE ) )
			VAR _RowSvg =
			    CONCATENATEX (
			        _Rows,
			        VAR _y = 70 + ( [@rank] - 1 ) * 42
			        VAR _p =
			            DIVIDE ( InvestmentProjects[CapexUSD],
			                LOOKUPVALUE ( InvestmentScenarios[AnnualOperatingProfitImpactUSD],
			                    InvestmentScenarios[ProjectID], InvestmentProjects[ProjectID],
			                    InvestmentScenarios[Scenario], _s ) )
			        VAR _ready = YEAR ( EDATE ( InvestmentProjects[EarliestStart], InvestmentProjects[DurationMonths] ) )
			        RETURN
			            "<text x='16' y='" & _y & "' font-size='11' font-weight='600' fill='%23252547'>"
			                & InvestmentProjects[Short Name] & "</text>"
			                & "<text x='16' y='" & ( _y + 15 ) & "' font-size='10' fill='%235B5B7A'>$"
			                & FORMAT ( InvestmentProjects[CapexUSD] / 1000000, "0.0" ) & "M · ready " & _ready & "</text>"
			                & "<rect x='" & _X0 & "' y='" & ( _y - 8 ) & "' width='180' height='10' rx='5' fill='%23F1EEE9'/>"
			                & "<rect x='" & _X0 & "' y='" & ( _y - 8 ) & "' width='" & FORMAT ( MIN ( _p, 15 ) * _SC, "0" )
			                & "' height='10' rx='5' fill='%23E8231D'/>"
			                & "<text x='" & ( _X0 + 184 ) & "' y='" & ( _y + 1 ) & "' font-size='11' font-weight='600' fill='%23B81C17'>"
			                & FORMAT ( _p, "0.0" ) & "y</text>",
			        "",
			        InvestmentProjects[CapexUSD], DESC
			    )
			VAR _Low =
			    CALCULATE ( SUM ( ProjectFlows[NetCashFlowUSD] ),
			        REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( Scenario ), REMOVEFILTERS ( InvestmentProjects ),
			        ProjectFlows[Scenario] = "Low", InvestmentProjects[Recommended] = "Funded" )
			VAR _High =
			    CALCULATE ( SUM ( ProjectFlows[NetCashFlowUSD] ),
			        REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( Scenario ), REMOVEFILTERS ( InvestmentProjects ),
			        ProjectFlows[Scenario] = "High", InvestmentProjects[Recommended] = "Funded" )
			VAR _LowTxt  = IF ( _Low < 0, "-$", "+$" ) & FORMAT ( ABS ( _Low ) / 1000000, "0.0" ) & "M"
			VAR _HighTxt = IF ( _High < 0, "-$", "+$" ) & FORMAT ( ABS ( _High ) / 1000000, "0.0" ) & "M"
			VAR _AllHotels = COUNTROWS ( FILTER ( ALL ( Hotels ), Hotels[Brand] = "Goodnight Inn" ) )
			VAR _Aging =
			    COUNTROWS (
			        FILTER ( ALL ( Hotels ),
			            Hotels[Brand] = "Goodnight Inn"
			                && DATEDIFF ( Hotels[ProductDate], DATE ( 2030, 12, 31 ), MONTH ) > 120 ) )
			VAR _Reserve = [Brand Budget] - _FundCapex
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='400' height='239' viewBox='0 0 400 239' font-family='Segoe UI, Arial'>"
			        & "<rect x='0.5' y='0.5' width='399' height='238' rx='10' fill='%23FFFFFF' stroke='%23E6DCD2'/>"
			        & "<text x='16' y='24' font-size='13' font-weight='600' fill='%23252547'>Not funded, and why</text>"
			        & "<text x='16' y='40' font-size='10' fill='%235B5B7A'>Years to pay back capex vs the funded plan (" & _s & ")</text>"
			        & _RowSvg
			        & "<line x1='" & _fx & "' y1='52' x2='" & _fx & "' y2='160' stroke='%232F5A9E' stroke-width='2' stroke-dasharray='3 2'/>"
			        & "<text x='" & _fxLabel & "' y='52' font-size='10' font-weight='600' fill='%232F5A9E'>Plan " & FORMAT ( _Plan, "0.0" ) & "y</text>"
			        & "<line x1='16' y1='176' x2='384' y2='176' stroke='%23EFE8DF'/>"
			        & "<text x='16' y='196' font-size='10' fill='%23252547'><tspan font-weight='600'>Risk </tspan>Cumulative cash by 2032: " & _LowTxt & " (Low) to " & _HighTxt & " (High)</text>"
			        & "<text x='16' y='214' font-size='10' fill='%23252547'><tspan font-weight='600'>Watch </tspan>" & _Aging & " of " & _AllHotels & " hotels pass 10 yrs since refresh by 2030</text>"
			        & "<text x='16' y='230' font-size='10' fill='%235B5B7A'>$" & FORMAT ( _Reserve / 1000000, "0.0" ) & "M reserve keeps a refresh decision open</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & _svg
			
			```
		lineageTag: 67be35d7-ab5e-4e47-9c15-4c865e67c8ad
		dataCategory: ImageUrl

	measure 'Type Font Color' =
			
			IF ( SELECTEDVALUE ( InvestmentProjects[Type] ) = "Growth", "#2F5A9E", "#5B5B7A" )
		lineageTag: fc63f3cf-71c6-49f0-a857-8c571bfeda25

	column Column
		formatString: 0
		lineageTag: 0535f51a-b77f-4758-b6d4-8241dd73f7b5
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 25d57c8c6add494d8c0d3e55f7d9919a

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

